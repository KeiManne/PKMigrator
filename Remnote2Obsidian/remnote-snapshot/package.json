{
  "private": true,
  "name": "pkmigrator-remnote-snapshot",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "validate-manifest": "node scripts/validate-manifest.cjs",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "dev": "cross-env NODE_ENV=development webpack serve --color --progress --no-open",
    "build": "npm run validate-manifest && shx rm -rf dist PluginZip.zip && cross-env NODE_ENV=production webpack --color --progress && cd dist && bestzip ../PluginZip.zip ./*"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "0.0.46",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "17.0.87",
    "@types/react-dom": "17.0.26",
    "bestzip": "2.2.1",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "10.0.0",
    "esbuild-loader": "4.4.0",
    "html-webpack-plugin": "5.6.4",
    "shx": "0.4.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  }
}
